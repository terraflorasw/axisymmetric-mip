// Phase 1 eigenmode — alumina DR ring + ICP torch in a PEC enclosure.
// See refs/ignition-study.md §4.1.
//
// Mesh attributes come from geometry.py physical groups:
//   1 alumina   2 quartz   3 bore   4 air   5 pec
{
  "Problem":
  {
    "Type": "Eigenmode",
    "Verbose": 2,
    "Output": "postpro/eigenmode"
  },

  "Model":
  {
    "Mesh": "ring.msh",
    // Mesh is written in metres, so the length scale is 1.0.
    "L0": 1.0,
    "Refinement":
    {
      "UniformLevels": 0
    }
  },

  "Domains":
  {
    "Materials":
    [
      // Alumina ring, >99.9% Al2O3.
      // LossTan is a PLACEHOLDER — see refs/ignition-study.md §9 q1.
      // Q scales as 1/tand and field enhancement as sqrt(Q), so this
      // value materially affects the ignition margin.
      {
        "Attributes": [1],
        "Permittivity": 9.8,
        "Permeability": 1.0,
        "LossTan": 1.0e-4
      },
      // Fused quartz torch outer tube
      {
        "Attributes": [2],
        "Permittivity": 3.78,
        "Permeability": 1.0,
        "LossTan": 1.0e-4
      },
      // Bore gas (N2 / air). Kept as a separate domain so field energy in
      // the bore can be integrated separately from the surrounding air —
      // this is the region that has to break down.
      {
        "Attributes": [3],
        "Permittivity": 1.0,
        "Permeability": 1.0
      },
      // Surrounding air inside the enclosure
      {
        "Attributes": [4],
        "Permittivity": 1.0,
        "Permeability": 1.0
      }
    ],

    // This is what makes mode CLASSIFICATION possible, and it is the point
    // of Phase 1. For each mode Palace reports electric and magnetic field
    // energy per domain. The operating mode is magnetic-dominated in the
    // bore (axial H, azimuthal polarisation current in the ring). An
    // ignition candidate is ELECTRIC-dominated in the bore — that is the
    // mode we are hunting for.
    "Postprocessing":
    {
      // NOTE: "Probe" (point field sampling) requires MFEM_USE_GSLIB, which is
      // OFF in build-palace.sh. Not re-enabled because it is redundant — the
      // ParaView field output can be sampled at arbitrary points with pyvista,
      // and the per-domain energy integrals below are what drives the mode
      // classification anyway.
      "Energy":
      [
        { "Index": 1, "Attributes": [3] },   // bore gas — the breakdown region
        { "Index": 2, "Attributes": [1] },   // alumina ring — stored energy
        { "Index": 3, "Attributes": [2] }    // quartz tube
      ]
    }
  },

  "Boundaries":
  {
    "PEC":
    {
      "Attributes": [5]
    }
  },

  "Solver":
  {
    "Order": 3,
    "Device": "CPU",
    "Eigenmode":
    {
      // Target below the band so the sweep brackets both the operating mode
      // and any enclosure cavity modes nearby. N is deliberately large:
      // mode IDENTIFICATION is the deliverable, not just f0.
      "Target": 2.45,
      "N": 24,
      "Tol": 1.0e-8,
      "MaxIts": 200,
      "Save": 8
    },
    "Linear":
    {
      "Type": "Default",
      "KSPType": "GMRES",
      "Tol": 1.0e-8,
      "MaxIts": 500
    }
  }
}
