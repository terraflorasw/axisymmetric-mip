// TE011 circular cavity + quartz torch, PEC walls. No ceramic, no iris.
// See refs/axisymmetric-feed.md §5 — the deliverable is the mode table and
// the azimuthal index m of every mode in 2.0-3.0 GHz.
//
// Mesh attributes come from geometry.py physical groups:
//   1 bore   2 quartz   3..7 air sectors 1..5   90 pec
{
  "Problem":
  {
    "Type": "Eigenmode",
    "Verbose": 2,
    "Output": "postpro/cav"
  },

  "Model":
  {
    "Mesh": "cav.msh",
    // Mesh is written in metres.
    "L0": 1.0,
    "Refinement":
    {
      "UniformLevels": 0
    }
  },

  "Domains":
  {
    "Materials":
    [
      // Bore gas (N2 / air). Separate domain so the filling factor eta can be
      // integrated directly — refs/axisymmetric-feed.md §6 predicts 0.092%
      // for a 9 mm bore, from an analytic EMPTY-cavity integral. This run is
      // what replaces that estimate with the torch actually present.
      {
        "Attributes": [1],
        "Permittivity": 1.0,
        "Permeability": 1.0
      },
      // Fused quartz torch outer tube
      {
        "Attributes": [2],
        "Permittivity": 3.78,
        "Permeability": 1.0,
        "LossTan": 1.0e-4
      },
      // Air, split into 5 azimuthal sectors. Identical material — the split
      // exists ONLY so per-domain energy reveals the azimuthal index.
      {
        "Attributes": [3, 4, 5, 6, 7],
        "Permittivity": 1.0,
        "Permeability": 1.0
      }
    ],

    // Mode classification. Two things are being measured:
    //
    //   eta and E/H in the bore  -> is this the ICP-analogue mode? TE011 is
    //                               H-dominated in the bore (axial H maximum
    //                               on axis, azimuthal E vanishing on axis).
    //
    //   sector energy spread     -> the azimuthal index m. Equal across all
    //                               five sectors means m=0. This is the check
    //                               degeneracy grouping cannot do here,
    //                               because TE0np and TM1np are EXACTLY
    //                               degenerate (chi'_0n == chi_1n).
    "Postprocessing":
    {
      "Energy":
      [
        { "Index": 1, "Attributes": [1] },   // bore gas
        { "Index": 2, "Attributes": [2] },   // quartz tube
        { "Index": 3, "Attributes": [3] },   // air sector 1
        { "Index": 4, "Attributes": [4] },   // air sector 2
        { "Index": 5, "Attributes": [5] },   // air sector 3
        { "Index": 6, "Attributes": [6] },   // air sector 4
        { "Index": 7, "Attributes": [7] }    // air sector 5
      ]
    }
  },

  "Boundaries":
  {
    // Cavity wall and both end caps. Sector-boundary faces are internal and
    // deliberately excluded — making them conducting would turn one cavity
    // into five wedge resonators.
    "PEC":
    {
      "Attributes": [90]
    }
  },

  "Solver":
  {
    "Order": 2,
    "Device": "CPU",
    "Eigenmode":
    {
      // Wide net: mode IDENTIFICATION is the deliverable, and the analytic
      // table predicts 7 modes in 2.0-3.0 GHz. N is generous so nothing in
      // the window is missed.
      "Target": 2.0,
      "N": 20,
      "Tol": 1.0e-8,
      "MaxIts": 200,
      "Save": 4
    },
    "Linear":
    {
      "Type": "Default",
      "KSPType": "GMRES",
      "Tol": 1.0e-8,
      "MaxIts": 500
    }
  }
}
